{
  "api_base_url": "https://api.portaldatransparencia.gov.br/api-de-dados",
  "rate_limit": {
    "requests_per_minute": 300,
    "delay_between_requests": 0.2
  },
  "pagination": {
    "max_pages": 1000,
    "page_size": 500
  },
  "datasets": [
    {
      "name": "federal_transfers",
      "endpoint": "/despesas/recursos-recebidos",
      "params": {
        "mesAnoInicio": "01/2010",
        "mesAnoFim": "12/2022",
        "pagina": 1
      },
      "requires_pagination": true,
      "filename": "federal_transfers.json",
      "description": "Federal transfers to municipalities across the full intercensal window (Jan 2010 - Dec 2022). Auto-expands to monthly files."
    },
    {
      "name": "ceis_sanctions",
      "endpoint": "/ceis",
      "params": {
        "pagina": 1
      },
      "requires_pagination": true,
      "filename": "ceis_compliance.json",
      "description": "CGU Register of Ineligible and Suspended Companies (CEIS)"
    },
    {
      "name": "cnep_sanctions",
      "endpoint": "/cnep",
      "params": {
        "pagina": 1
      },
      "requires_pagination": true,
      "filename": "cnep_compliance.json",
      "description": "National Registry of Punished Companies (CNEP)"
    },
    {
      "name": "cepim_sanctions",
      "endpoint": "/cepim",
      "params": {
        "pagina": 1
      },
      "requires_pagination": true,
      "filename": "cepim_compliance.json",
      "description": "Registry of Impediment to Contract with Public Administration (CEPIM)"
    }
  ]
}
